<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.payroll.controller.AttendanceController"
      spacing="16" style="-fx-padding: 4;">

    <!-- TOP FILTER TOOLBAR -->
    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="card" style="-fx-padding: 12 16;">
        <Label text="Period:" style="-fx-font-weight: bold; -fx-text-fill: -color-text-main;"/>
        <ComboBox fx:id="cmbMonth" prefWidth="140" prefHeight="38"/>
        <ComboBox fx:id="cmbYear" prefWidth="100" prefHeight="38"/>

        <Button text="Load Records" onAction="#loadAttendance" styleClass="btn-secondary" prefHeight="38"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="📥 Export CSV" onAction="#handleExportCsv" styleClass="btn-secondary" prefHeight="38"/>
        <Button text="➕ Record Attendance" onAction="#showRecordAttendanceDialog" styleClass="btn-primary" prefHeight="38"/>
    </HBox>

    <!-- ATTENDANCE TABLE -->
    <VBox styleClass="card" VBox.vgrow="ALWAYS" spacing="12">
        <HBox alignment="CENTER_LEFT">
            <Label fx:id="lblTableSummary" text="Attendance Log" style="-fx-font-weight: bold; -fx-text-fill: -color-text-main;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Prevents duplicate entries for same employee and date" style="-fx-text-fill: -color-text-muted; -fx-font-size: 11;"/>
        </HBox>

        <TableView fx:id="tblAttendance" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colAttDate" text="Date" prefWidth="110"/>
                <TableColumn fx:id="colAttCode" text="Emp ID" prefWidth="90"/>
                <TableColumn fx:id="colAttName" text="Employee Name" prefWidth="160"/>
                <TableColumn fx:id="colAttDept" text="Department" prefWidth="140"/>
                <TableColumn fx:id="colAttStatus" text="Status" prefWidth="110"/>
                <TableColumn fx:id="colAttInTime" text="Check In" prefWidth="90"/>
                <TableColumn fx:id="colAttOutTime" text="Check Out" prefWidth="90"/>
                <TableColumn fx:id="colAttNotes" text="Notes" prefWidth="180"/>
                <TableColumn fx:id="colAttActions" text="Actions" prefWidth="130"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </VBox>

</VBox>
