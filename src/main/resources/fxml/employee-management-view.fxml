<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.payroll.controller.EmployeeManagementController"
      spacing="16" style="-fx-padding: 4;">

    <!-- TOP FILTER & ACTION TOOLBAR -->
    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="card" style="-fx-padding: 12 16;">
        <!-- Search Input -->
        <TextField fx:id="txtSearch" promptText="🔍  Search by name, ID, email..." prefWidth="280" prefHeight="38"/>

        <!-- Department Filter -->
        <ComboBox fx:id="cmbDepartmentFilter" promptText="All Departments" prefWidth="180" prefHeight="38"/>

        <!-- Status Filter -->
        <ComboBox fx:id="cmbStatusFilter" promptText="All Statuses" prefWidth="150" prefHeight="38"/>

        <Button text="Filter" onAction="#handleSearch" styleClass="btn-secondary" prefHeight="38"/>
        <Button text="Reset" onAction="#handleResetFilter" styleClass="btn-secondary" prefHeight="38"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="📥 Export CSV" onAction="#handleExportCsv" styleClass="btn-secondary" prefHeight="38"/>
        <Button text="➕ Register Employee" onAction="#showAddEmployeeDialog" styleClass="btn-primary" prefHeight="38"/>
    </HBox>

    <!-- EMPLOYEE DIRECTORY TABLE CARD -->
    <VBox styleClass="card" VBox.vgrow="ALWAYS" spacing="12">
        <HBox alignment="CENTER_LEFT">
            <Label fx:id="lblTableCount" text="Showing 0 Employees" style="-fx-font-weight: bold; -fx-text-fill: -color-text-main;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Select an employee row to edit profile or configure salary" style="-fx-text-fill: -color-text-muted; -fx-font-size: 11;"/>
        </HBox>

        <TableView fx:id="tblEmployees" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colEmpCode" text="Emp ID" prefWidth="90"/>
                <TableColumn fx:id="colEmpName" text="Full Name" prefWidth="160"/>
                <TableColumn fx:id="colEmpEmail" text="Corporate Email" prefWidth="180"/>
                <TableColumn fx:id="colEmpDept" text="Department" prefWidth="150"/>
                <TableColumn fx:id="colEmpDesig" text="Designation" prefWidth="160"/>
                <TableColumn fx:id="colEmpJoinDate" text="Join Date" prefWidth="100"/>
                <TableColumn fx:id="colEmpGross" text="Gross Salary" prefWidth="110"/>
                <TableColumn fx:id="colEmpStatus" text="Status" prefWidth="100"/>
                <TableColumn fx:id="colEmpActions" text="Actions" prefWidth="200"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </VBox>

</VBox>
